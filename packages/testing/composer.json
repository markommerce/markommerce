{
    "name": "markommerce/testing",
    "description": "Testing utilities for Markommerce — integration test scaffolding, fakes, and test helpers",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "marko/database-pgsql": "self.version"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Testing\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
