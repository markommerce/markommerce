{
    "name": "markommerce/attribute",
    "description": "Attribute module for Markommerce",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Attribute\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Attribute\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
