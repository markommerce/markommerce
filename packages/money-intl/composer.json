{
    "name": "markommerce/money-intl",
    "description": "Locale-aware money formatting for Markommerce — renders Money via ext-intl NumberFormatter using the active locale scope",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "marko/core": "self.version",
        "markommerce/money": "self.version",
        "markommerce/locale": "self.version",
        "markommerce/scope": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\MoneyIntl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\MoneyIntl\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
