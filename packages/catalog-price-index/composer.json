{
    "name": "markommerce/catalog-price-index",
    "description": "Product price index storage — single bulk-upsert table keyed on product_id with per-market scope overrides in a JSONB column",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "markommerce/catalog": "self.version",
        "markommerce/currency": "self.version",
        "markommerce/money": "self.version",
        "markommerce/scope": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "markommerce/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\CatalogPriceIndex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\CatalogPriceIndex\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
