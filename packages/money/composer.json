{
    "name": "markommerce/money",
    "description": "Markommerce money interfaces — MoneyInterface, MoneyFactoryInterface, and CurrencyConfigInterface",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Money\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Money\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
