{
    "name": "markommerce/money",
    "description": "Money and Currency value objects for Markommerce — exact BigDecimal arithmetic, immutable, currency-safe",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "brick/math": "^0.12 || ^0.13"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Money\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Money\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
