{
    "name": "markommerce/catalog-attribute-index",
    "description": "Product attribute index storage for Markommerce — indexed attribute values per scope",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "markommerce/attribute": "self.version",
        "markommerce/catalog": "self.version",
        "markommerce/catalog-attribute": "self.version",
        "markommerce/catalog-attribute-scope": "self.version",
        "markommerce/indexer": "self.version",
        "markommerce/scope": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "markommerce/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\CatalogAttributeIndex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\CatalogAttributeIndex\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
