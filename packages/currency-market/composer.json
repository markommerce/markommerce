{
    "name": "markommerce/currency-market",
    "description": "Market bridge for Markommerce currency — registers the base currency config key on the market axis for per-market overrides",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "markommerce/currency": "self.version",
        "markommerce/config-scope": "self.version",
        "markommerce/market": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\CurrencyMarket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\CurrencyMarket\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
