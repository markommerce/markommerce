{
    "name": "markommerce/pricing",
    "description": "Pricing pipeline for Markommerce — PriceResolver contract and base resolver turning a product's stored amount into Money, with a plugin decoration seam",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "markommerce/money": "self.version",
        "markommerce/catalog": "self.version",
        "markommerce/currency": "self.version",
        "markommerce/catalog-scope": "self.version",
        "markommerce/scope": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Pricing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Pricing\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
