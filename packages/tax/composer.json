{
    "name": "markommerce/tax",
    "description": "Tax mode configuration for Markommerce — globally configurable tax-inclusive/exclusive pricing mode (no rate computation)",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "markommerce/config": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Tax\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Tax\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
