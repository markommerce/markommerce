{
    "name": "markommerce/catalog",
    "description": "Catalog module for Markommerce — products and categories",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "markommerce/config": "self.version",
        "markommerce/criteria": "self.version",
        "markommerce/currency": "self.version",
        "markommerce/money": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "markommerce/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Catalog\\": "src/",
            "Markommerce\\Catalog\\Seed\\": "Seed/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Catalog\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
