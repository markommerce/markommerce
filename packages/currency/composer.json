{
    "name": "markommerce/currency",
    "description": "Currency configuration for Markommerce — globally configurable base currency resolved into a Money Currency value object",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "markommerce/money": "self.version",
        "markommerce/config": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Currency\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Currency\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
