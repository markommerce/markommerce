{
    "name": "markommerce/frontend-demo",
    "description": "Frontend demo module for Markommerce — showcases storefront layout, routing, and Latte views",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/config": "self.version",
        "marko/core": "self.version",
        "marko/layout": "self.version",
        "marko/routing": "self.version",
        "marko/view": "self.version",
        "marko/view-latte": "self.version",
        "markommerce/frontend": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\FrontendDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\FrontendDemo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
