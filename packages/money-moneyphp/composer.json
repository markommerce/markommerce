{
    "name": "markommerce/money-moneyphp",
    "description": "Markommerce money driver — MoneyInterface implementation backed by moneyphp/money",
    "type": "marko-module",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "marko/core": "self.version",
        "markommerce/money": "self.version",
        "moneyphp/money": "^4.5"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Money\\Moneyphp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Money\\Moneyphp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
