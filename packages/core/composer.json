{
    "name": "markommerce/core",
    "description": "Markommerce core",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.5"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
