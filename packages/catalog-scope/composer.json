{
    "name": "markommerce/catalog-scope",
    "description": "Scope storage bridge for catalog entities — adds scoped override support to Product and Category",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "markommerce/catalog": "self.version",
        "markommerce/scope": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\CatalogScope\\": "src/",
            "Markommerce\\CatalogScope\\Seed\\": "Seed/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\CatalogScope\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
