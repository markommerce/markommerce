{var $facetGroups = $facets ?? []}
{var $activeFilterList = $activeFilters ?? []}
{var $allClearUrl = $clearAllUrl ?? null}
<div class="catalog-facet-sidebar">
    {if count($activeFilterList) > 0}
        <div class="catalog-facet-active">
            <mk-cluster gap="2" class="catalog-facet-active__chips">
                {foreach $activeFilterList as $activeFilter}
                    {foreach $activeFilter->values as $index => $value}
                        {var $label = $activeFilter->labels[$index] ?? $value}
                        <mk-badge variant="neutral" size="sm" class="catalog-facet-active__chip">
                            <span class="catalog-facet-active__chip-label">{$label}</span>
                            {if isset($toggleUrls[$activeFilter->code][$value])}
                                <a href="{$toggleUrls[$activeFilter->code][$value]|noescape}" class="catalog-facet-active__remove" aria-label="Remove {$label}">×</a>
                            {/if}
                        </mk-badge>
                    {/foreach}
                {/foreach}
            </mk-cluster>
            {if $allClearUrl !== null}
                <a href="{$allClearUrl|noescape}" class="catalog-facet-active__clear">Clear all</a>
            {/if}
        </div>
    {/if}
    {foreach $facetGroups as $facet}
        <div class="catalog-facet-sidebar__group" data-facet-code="{$facet->code}" role="group" aria-labelledby="facet-title-{$facet->code}">
            <p class="catalog-facet-sidebar__group-title" id="facet-title-{$facet->code}">{$facet->code}</p>
            <ul class="catalog-facet-sidebar__values">
                {foreach $facet->values as $facetValue}
                    <li class="catalog-facet-sidebar__value{if $facetValue->selected} catalog-facet-sidebar__value--selected{/if}"{if $facetValue->selected} aria-current="true"{/if}>
                        {if isset($toggleUrls[$facet->code][$facetValue->value])}
                            <a href="{$toggleUrls[$facet->code][$facetValue->value]|noescape}" class="catalog-facet-sidebar__toggle"{if $facetValue->selected} aria-pressed="true"{/if}>
                                <span class="catalog-facet-sidebar__checkbox" aria-hidden="true"></span>
                                <span class="catalog-facet-sidebar__value-label">{$facetValue->label}</span>
                                <span class="catalog-facet-sidebar__count">({$facetValue->count})</span>
                                {if $facetValue->selected}
                                    <span class="catalog-facet-sidebar__value-selected visually-hidden">selected</span>
                                {/if}
                            </a>
                        {else}
                            <span class="catalog-facet-sidebar__toggle">
                                <span class="catalog-facet-sidebar__checkbox" aria-hidden="true"></span>
                                <span class="catalog-facet-sidebar__value-label">{$facetValue->label}</span>
                                <span class="catalog-facet-sidebar__count">({$facetValue->count})</span>
                                {if $facetValue->selected}
                                    <span class="catalog-facet-sidebar__value-selected visually-hidden">selected</span>
                                {/if}
                            </span>
                        {/if}
                    </li>
                {/foreach}
            </ul>
        </div>
    {/foreach}
</div>
