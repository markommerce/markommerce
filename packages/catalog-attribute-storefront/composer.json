{
    "name": "markommerce/catalog-attribute-storefront",
    "description": "Catalog attribute storefront — layered navigation binding: attribute filter contributor and facet assembler for the Markommerce storefront",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "markommerce/attribute": "self.version",
        "markommerce/attribute-scope": "self.version",
        "markommerce/catalog": "self.version",
        "markommerce/catalog-attribute": "self.version",
        "markommerce/catalog-attribute-index": "self.version",
        "markommerce/catalog-attribute-scope": "self.version",
        "markommerce/catalog-storefront": "self.version",
        "markommerce/criteria": "self.version",
        "markommerce/scope": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "markommerce/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\CatalogAttributeStorefront\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\CatalogAttributeStorefront\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
