{
    "name": "markommerce/layout-demo",
    "description": "Layout demo module for Markommerce — showcases the layout system end-to-end with context providers, typed DTOs, and extension operations",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/config": "self.version",
        "marko/core": "self.version",
        "marko/routing": "self.version",
        "marko/view": "self.version",
        "marko/view-latte": "self.version",
        "markommerce/layout": "self.version",
        "markommerce/theme-blank": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\LayoutDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\LayoutDemo\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
