{
    "name": "markommerce/catalog-market-category-trees",
    "description": "Market category trees for Markommerce catalog — category tree assignment and resolution per market",
    "license": "MIT",
    "type": "marko-module",
    "require": {
        "php": "^8.5",
        "marko/core": "self.version",
        "marko/database": "self.version",
        "markommerce/catalog": "self.version",
        "markommerce/market": "self.version"
    },
    "require-dev": {
        "marko/testing": "self.version",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Markommerce\\CatalogMarketCategoryTrees\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markommerce\\CatalogMarketCategoryTrees\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "marko": {
            "module": true
        }
    }
}
