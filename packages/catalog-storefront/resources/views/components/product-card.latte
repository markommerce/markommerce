<article class="catalog-product-card">
    <mk-stack gap="2">
        <img class="catalog-product-card__image"
            src="https://placehold.co/400x400?text={$product->sku}"
            alt="{$resolvedName}"
            width="400" height="400" loading="lazy">
        <mk-heading level="3" size="md">{$resolvedName}</mk-heading>
        {if $resolvedDesc}
            <mk-text variant="small">{$resolvedDesc}</mk-text>
        {/if}
        {if isset($_slots['badges'])}
            <div class="catalog-product-card__badges">
                {slot badges}{/slot}
            </div>
        {/if}
    </mk-stack>
</article>
